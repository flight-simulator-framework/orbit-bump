                    </property>
                    <property name="focusPolicy">
                     <enum>Qt::NoFocus</enum>
                    </property>
                    <property name="toolTip">
                     <string>&lt;html&gt;&lt;body&gt;&lt;p&gt;Read the reference orbit by clicking &lt;b&gt;Read reference orbit&lt;/b&gt;. It reads all BPMs and saves the selected BPM readings as a fixed reference.&lt;/p&gt;&lt;p&gt;Live BPM readings keep refreshing every few seconds. The bump is computed relative to that reference orbit.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                    </property>
                    <property name="styleSheet">
                     <string notr="true">QToolButton#read_reference_tooltip {
                     border: 1px solid #888;
                     border-radius: 10px;
                     min-width: 20px;
                     max-width: 20px;
                     min-height: 20px;
                     max-height: 20px;
                     padding: 0px;
                     font-weight: bold;
